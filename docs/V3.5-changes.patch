+.v35-history-row small{font-size:11px;color:#7E906D;font-weight:400;white-space:nowrap}
+.v35-support{margin-top:20px;padding-top:10px;border-top:1px solid rgba(80,96,70,.065)}
+.v35-support button{width:100%;min-height:44px;display:flex;align-items:center;gap:8px;border:0;border-radius:10px;background:transparent;text-align:left;padding:0 6px;color:#7E8776;font-size:13px}
+.v35-support button>span{flex:1}.v35-support button>svg{width:18px;height:18px}.v35-support i{display:grid;place-items:center;transform:rotate(180deg)}.v35-support i svg{width:14px;height:14px}
+.v35-account-bar button:active,.v35-services button:active,.v35-history-row:active,.v35-support button:active{background:rgba(114,144,92,.08)}
+.v35-membership:active{filter:brightness(.98)}
+.v35-account-bar button:focus-visible,.v35-drawer-scroll button:focus-visible{outline:2px solid #7C9D64;outline-offset:-2px}
+@media(prefers-reduced-motion:reduce){.v35-account-bar *, .v35-drawer-scroll *{transition:none;scroll-behavior:auto}}
